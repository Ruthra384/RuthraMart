# ============================================================
# RUTHRAMART ENVIRONMENT CONFIGURATION
# ============================================================

# Application Server Port
PORT=8080

# Database Configuration
# Default: Embedded persistent H2 file database (zero configuration required)
SPRING_DATASOURCE_URL=jdbc:h2:file:./data/ruthramart;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE;AUTO_SERVER=TRUE;MODE=MySQL
SPRING_DATASOURCE_DRIVER=org.h2.Driver
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=

# Optional MySQL Configuration (Uncomment to use local or cloud MySQL)
# SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/ruthramart?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true
# SPRING_DATASOURCE_DRIVER=com.mysql.cj.jdbc.Driver
# SPRING_DATASOURCE_USERNAME=root
# SPRING_DATASOURCE_PASSWORD=rootpassword

# AI Chatbot API Configuration (Optional: Leave blank for smart rule-based AI)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Default Administrator Credentials
ADMIN_DEFAULT_EMAIL=admin@ruthramart.com
ADMIN_DEFAULT_PASSWORD=Admin@123
